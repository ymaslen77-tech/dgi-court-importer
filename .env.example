# Copy to .env and replace the password. Never commit real credentials.
POSTGRES_PASSWORD=replace-with-a-long-unique-password
POSTGRES_PORT=5434
DATABASE_URL=postgresql://housing:replace-with-a-long-unique-password@127.0.0.1:5434/housing

# Isolated Payload CMS database; never reuse the public site DB.
CMS_POSTGRES_PASSWORD=replace-with-another-long-unique-password
CMS_POSTGRES_PORT=5435
