# Copy to .env and replace the password. Never commit real credentials.
POSTGRES_PASSWORD=replace-with-a-long-unique-password
POSTGRES_PORT=5434
DATABASE_URL=postgresql://housing:replace-with-a-long-unique-password@127.0.0.1:5434/housing

# Isolated Payload CMS database; never reuse the public site DB.
CMS_POSTGRES_PASSWORD=replace-with-another-long-unique-password
CMS_POSTGRES_PORT=5435

# Local Payload CMS runs separately from the site database.
PAYLOAD_SECRET=replace-with-separate-unique-32-plus-character-secret
# For first-time offline admin bootstrap only:
# CMS_BOOTSTRAP_EMAIL=admin@example.test
# CMS_BOOTSTRAP_PASSWORD=replace-with-independent-long-password
# Local flags must remain disabled.
SITE_CUTOVER=false
SITE_RELEASE_APPROVED=no
CMS_PUBLIC_READS=false
COURT_DB_READS=false
