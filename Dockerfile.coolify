# Coolify production/preview image. The release flags are provided by the container
# environment at runtime. Do not bake the staging values into the image.
FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN npm install -g pnpm@10.0.0
COPY . .
RUN pnpm install --frozen-lockfile
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @dgi/web build

FROM node:22-bookworm-slim
WORKDIR /app
RUN npm install -g pnpm@10.0.0
COPY --from=builder --chown=node:node /app /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
USER node
EXPOSE 3000
CMD ["pnpm", "--filter", "@dgi/web", "start"]
