# Coolify production/preview image. The release flags are provided by the container
# environment at runtime. Do not bake the staging values into the image.
FROM node:22-bookworm-slim AS builder
WORKDIR /app
# The registry can occasionally time out during a cold, no-cache Coolify build.
# Keep pnpm pinned to packageManager in package.json and allow bounded retries.
RUN npm install -g pnpm@10.0.0 \
    --fetch-retries=5 \
    --fetch-retry-mintimeout=10000 \
    --fetch-retry-maxtimeout=60000 \
    --fetch-timeout=90000
COPY . .
RUN pnpm install --frozen-lockfile
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @dgi/web build

FROM node:22-bookworm-slim
WORKDIR /app
# Reuse the exact tested package-manager binary from the builder image.
# This stage must not make a second npm registry request.
COPY --from=builder /usr/local/lib/node_modules/pnpm /usr/local/lib/node_modules/pnpm
RUN ln -s /usr/local/lib/node_modules/pnpm/bin/pnpm.cjs /usr/local/bin/pnpm
COPY --from=builder --chown=node:node /app /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
USER node
EXPOSE 3000
CMD ["pnpm", "--filter", "@dgi/web", "start"]
