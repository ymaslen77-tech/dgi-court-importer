# Preview deployments must NOT be indexed. Do not switch until DNS and SEO acceptance.
SITE_CUTOVER=false
# Separate release approval after legal, security, design and SEO sign-off.
SITE_RELEASE_APPROVED=no
# Once switched, set to the new production domain (including https://).
SITE_URL=https://dgimos.webflow.io
# The 16 candidate court cards come from a checked-in privacy-minimal JSON snapshot.
# Large or continuously updated court indexes use PostgreSQL via COURT_DB_READS.
# Arbitrary runtime JSONL paths are not supported by the standalone frontend build.
# Safe read-only PostgreSQL publication adapter; disabled by default.
CMS_PUBLIC_READS=false
# Payload CMS editor interface is not yet integrated.
# DATABASE_URL=postgresql://app:replace-me@localhost:5432/housing
# PAYLOAD_SECRET=replace-with-long-random-secret

# Optional database-backed court catalog, off until integrated QA.
# COURT_DB_READS=true
