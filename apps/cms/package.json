{
  "name": "@dgi/cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "import:webflow:dry-run": "tsx src/scripts/import-webflow-pages.ts --dry-run",
    "import:webflow:apply": "tsx src/scripts/import-webflow-pages.ts --apply",
    "promote:web:dry-run": "tsx src/scripts/promote-to-web.ts --dry-run",
    "promote:web:apply": "tsx src/scripts/promote-to-web.ts --apply",
    "test": "tsx --test tests/*.test.ts",
    "verify:staging": "tsx src/scripts/verify-staging.ts",
    "verify:local": "tsx src/scripts/verify-local.ts",
    "import:cms-metadata:dry-run": "tsx src/scripts/import-cms-metadata.ts --dry-run",
    "import:cms-metadata:apply": "tsx src/scripts/import-cms-metadata.ts --apply",
    "import:cms-private:dry-run": "tsx src/scripts/import-cms-private.ts --dry-run",
    "import:cms-private:apply": "tsx src/scripts/import-cms-private.ts --apply"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "graphql": "^16.9.0",
    "next": "^16.2.6",
    "payload": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/pg": "^8.15.5"
  },
  "engines": {
    "node": ">=22"
  }
}
