# TEMPLATE ONLY. Copy to deploy/staging/.env on a private host (chmod 600).
# Never commit live values; credentials below are intentionally unusable examples.
POSTGRES_PASSWORD=replace-site-password-with-unique-long-secret
CMS_POSTGRES_PASSWORD=replace-cms-password-with-another-long-secret
DATABASE_URL=postgresql://housing:replace-site-password-with-unique-long-secret@site-db:5432/housing
CMS_DATABASE_URL=postgresql://housing_cms:replace-cms-password-with-another-long-secret@cms-db:5432/housing_cms
PAYLOAD_SECRET=replace-with-unique-64-character-random-secret-before-deploy
STAGING_SITE_URL=https://staging.example.invalid
STAGING_CMS_URL=https://cms-staging.example.invalid
STAGING_WEB_PORT=3100
STAGING_CMS_PORT=3101
SITE_CUTOVER=false
SITE_RELEASE_APPROVED=no
CMS_PUBLIC_READS=false
COURT_DB_READS=false
STAGING_ISOLATED_COMPOSE=yes
